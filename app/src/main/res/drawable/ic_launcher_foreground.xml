<?xml version="1.0" encoding="utf-8"?>
<!-- White/silver shield, centred, at 85% of the original medium size. Design "1". -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="55"
        android:scaleX="0.85"
        android:scaleY="0.85">

        <!-- shadow -->
        <path
            android:fillColor="#59000000"
            android:pathData="M54,32 L74,39.5 V55 C74,68 65,78 54,82 C43,78 34,68 34,55 V39.5 Z" />

        <!-- shield -->
        <path android:pathData="M54,30 L74,37.5 V53 C74,66 65,76 54,80 C43,76 34,66 34,53 V37.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="42" android:startY="30"
                    android:endX="66" android:endY="80"
                    android:startColor="#FFFFFFFF"
                    android:endColor="#FFC9CEE3" />
            </aapt:attr>
        </path>

        <!-- right-half shade for depth -->
        <path
            android:fillColor="#14000000"
            android:pathData="M54,30 L74,37.5 V53 C74,66 65,76 54,80 Z" />
    </group>
</vector>
