    <string name="ob2_body">Contacts permission is required so calls from saved contacts are screened too, and so favourites ★ work.</string>
    <string name="ob3_title">WhatsApp &amp; background</string>
    <string name="ob3_body">Notification access lets the app reject WhatsApp and other app calls. The battery exemption stops the system from closing the app.</string>
    <string name="ob4_title">Add your first allowed number</string>
    <string name="ob4_body">Add a number now or later. Anyone not on the list will be rejected.</string>
