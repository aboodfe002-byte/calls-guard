    <string name="set_section_blocking">Blocking</string>
    <string name="set_enabled">Enable blocking</string>
    <string name="set_enabled_desc">Reject everyone except allowed numbers. When off, all calls ring.</string>
    <string name="set_app_calls">Reject WhatsApp and app calls</string>
    <string name="set_app_calls_desc">Rejects WhatsApp, Telegram and other app calls from anyone not allowed.</string>
